# coding=utf-8
# Kich ban 3.5 (kiem toan coc CDM that Ec=40000kPa) — GD5 + ap luc vua hang x=0,
# muc P=P_tuong_ungkPa (tuong duong muc tieu Ux_dinh=80cm da tinh bang CalculiX) —
# CROSS-CHECK bang Code_Aster, luoi + nhom dung tu Salome-Meca (khong qua gmsh).
#
# Vat lieu dat yeu: MOHR_COULOMB, PHI=0 (Tresca, giong quy uoc CalculiX), Su=5000kPa
# khong bind (muc dich co lap anh huong do cung, giong CalculiX truoc do).

from code_aster.Commands import *

DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"), DEBUG=_F(SDVERI="OUI"))

MA = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

MA = MODI_MAILLAGE(
    reuse=MA, MAILLAGE=MA,
    ORIE_PEAU=_F(GROUP_MA_PEAU=(
        "BASE", "SIDE_XMIN", "SIDE_XMAX", "SIDE_YMIN", "SIDE_YMAX",
        "TOP_SOIL_NEGX", "TOP_SOIL_POSX", "TOP_COLUMN_NEGX", "TOP_COLUMN_POSX",
    )),
)

MO = AFFE_MODELE(MAILLAGE=MA, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

# ================== Vat lieu ==================
MAT_DAP = DEFI_MATERIAU(ELAS=_F(E=8000.0, NU=0.30, RHO=19.0 / 9.81))
MAT_CUNG = DEFI_MATERIAU(ELAS=_F(E=27600.0, NU=0.35, RHO=19.0 / 9.81))
MAT_COL = DEFI_MATERIAU(ELAS=_F(E=40000.0, NU=0.25, RHO=18.0 / 9.81))
MAT_YEU = DEFI_MATERIAU(
    ELAS=_F(E=3450.0, NU=0.35, RHO=15.291 / 9.81),
    MOHR_COULOMB=_F(PHI=0.001, ANGDIL=0.0, COHESION=5000.0),
)

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MA,
    AFFE=(
        _F(GROUP_MA="SOIL_dat_dap", MATER=MAT_DAP),
        _F(GROUP_MA="SOIL_lop_cung", MATER=MAT_CUNG),
        _F(GROUP_MA="CDM_COLUMN", MATER=MAT_COL),
        _F(GROUP_MA="SOIL_dat_yeu", MATER=MAT_YEU),
    ),
)

# ================== Dieu kien bien (giong CalculiX *BOUNDARY) ==================
DEPL = AFFE_CHAR_CINE(
    MODELE=MO,
    MECA_IMPO=(
        _F(GROUP_MA="BASE", DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_MA="SIDE_XMIN", DX=0.0),
        _F(GROUP_MA="SIDE_XMAX", DX=0.0),
        _F(GROUP_MA="SIDE_YMIN", DY=0.0),
        _F(GROUP_MA="SIDE_YMAX", DY=0.0),
    ),
)

# ================== Tai GD5 — ap luc mat THAT tren nua mien +X (q=40.8kPa nen) ==================
CHAR_GD5 = AFFE_CHAR_MECA(
    MODELE=MO,
    PRES_REP=(
        _F(GROUP_MA="TOP_SOIL_POSX", PRES=40.8),
        _F(GROUP_MA="TOP_COLUMN_POSX", PRES=40.8),
    ),
)

# ================== Tai vua hang x=0 — luc khoi tuong duong (kN/m3), huong +X ==================
# P=P_tuong_ung kPa, D=0.8m -> FX = 4P/(pi.D) = 4651.43 kN/m3 (xem doc string ccx tuong duong)
CHAR_VUA = AFFE_CHAR_MECA(MODELE=MO, FORCE_INTERNE=_F(GROUP_MA="CDM_COLUMN_ROW_X0", FX=4651.43))

# ================== Giai STAT_NON_LINE (Mohr-Coulomb dat yeu) ==================
LINST = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10))
DEFLIST = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=LINST),
    ECHEC=_F(EVENEMENT="ERREUR", ACTION="DECOUPE", SUBD_METHODE="MANUEL", SUBD_PAS=4, SUBD_NIVEAU=5),
)

RESU = STAT_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CHMAT,
    EXCIT=(_F(CHARGE=CHAR_GD5), _F(CHARGE=CHAR_VUA), _F(CHARGE=DEPL)),
    COMPORTEMENT=(
        _F(RELATION="MOHR_COULOMB", GROUP_MA="SOIL_dat_yeu"),
        _F(RELATION="ELAS", GROUP_MA=("SOIL_dat_dap", "SOIL_lop_cung", "CDM_COLUMN")),
    ),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-4, ITER_GLOB_MAXI=20),
    INCREMENT=_F(LIST_INST=DEFLIST, INST_FIN=1.0),
    SOLVEUR=_F(METHODE="MUMPS"),
)

RESU = CALC_CHAMP(reuse=RESU, CONTRAINTE=("SIGM_ELNO",), RESULTAT=RESU)
RESU = CALC_CHAMP(reuse=RESU, CONTRAINTE="SIGM_NOEU", RESULTAT=RESU)

# ================== Trich Ux tai dinh hang x=0 (nut GAN NHAT (0,0,0.8), khong loc nguong) ==================
# Dung POST_RELEVE_T (da xac nhan qua ssnv232b.comm) — AN TOAN hon goi truc tiep
# API doi tuong Python (RESU.getField) CHUA tung kiem chung trong du an nay.
MA_PY = MA.getCoordinates().getValues()
n_nodes = len(MA_PY) // 3
best_i, best_d2 = 0, 1e18
for i in range(n_nodes):
    x, y, z = MA_PY[3 * i], MA_PY[3 * i + 1], MA_PY[3 * i + 2]
    d2 = x * x + y * y + (z - 0.8) ** 2
    if d2 < best_d2:
        best_d2, best_i = d2, i
print("NUT DINH HANG X0 (0-idx):", best_i, "toa do:", MA_PY[3*best_i:3*best_i+3], "khoang_cach2:", best_d2)

node_name = "N%d" % (best_i + 1)  # quy uoc N<n> 1-indexed, cung thu tu getCoordinates()
MA = DEFI_GROUP(reuse=MA, MAILLAGE=MA, CREA_GROUP_NO=_F(NOM="PT_DINH_X0", NOEUD=node_name))

TAB_UX = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="UX_DINH_X0", GROUP_NO="PT_DINH_X0", RESULTAT=RESU,
        NOM_CHAM="DEPL", TOUT_CMP="OUI", OPERATION="EXTRACTION",
    )
)
IMPR_TABLE(TABLE=TAB_UX)

IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=RESU, NOM_CHAM=("DEPL", "SIGM_NOEU")))

FIN()
