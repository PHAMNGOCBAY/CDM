{
  "name": "claude-automator",
  "displayName": "Claude Automator",
  "description": "Automatically toggles the confirmation prompt for Claude Code actions",
  "version": "1.0.0",
  "publisher": "phamngocbay",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "automation",
    "auto-approve",
    "ai"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeAutomator.toggleAutoApprove",
        "title": "Claude Automator: Toggle Auto-Approve",
        "icon": "$(zap)"
      }
    ],
    "configuration": {
      "title": "Claude Automator",
      "properties": {
        "claudeAutomator.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether auto-approval is currently enabled for Claude Code actions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo pre-compiled",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.120.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phamngocbay/claude-automator"
  }
}
