{
  "_meta": {
    "source": "giao dien/01-05-UI-*.png  +  11-sw-pile-database.md",
    "rule": "All UI labels in English, following GEO5 naming convention",
    "updated": "2026-05-15",
    "version": "v4"
  },
  "app_title": "Lateral Pile Analysis — SW Prestressed Concrete (BETON 6)",
  "tabs": [
    "Geo Data",
    "Soil Layers",
    "Concentrated Forces",
    "Boussinesq",
    "Sheet Pile Section",
    "Results"
  ],
  "geo_data": {
    "reference_image": "giao dien/01-UI-GEODAT.png",
    "fields": [
      {"label": "Pile Top Level [m]",      "key": "top_elev",         "default": 0.0,  "step": 0.5, "geo5_equiv": "Sheet Pile Top Level [m]"},
      {"label": "Soil Level in Front [m]", "key": "soil_level_front", "default": 0.0,  "step": 0.5, "geo5_equiv": "Soil Level in Front [m]"},
      {"label": "Soil Level behind [m]",   "key": "soil_level_back",  "default": 0.0,  "step": 0.5, "geo5_equiv": "— (new, back side natural ground)"},
      {"label": "Water Level [m]",         "key": "water_level",      "default": -1.0, "step": 0.5, "geo5_equiv": "Water Level in Front [m]"},
      {"label": "Pile Length [m]",         "key": "L_m",              "default": 20.0, "step": 0.5, "geo5_equiv": "derived from top - tip"},
      {"label": "Earth Support",           "key": "bc_type",          "options": ["Fixed","Free","Cantilever"], "geo5_equiv": "Earth Support dropdown"}
    ],
    "diagram_labels": {
      "top_marker": "SP Top",
      "water_marker": "Water",
      "front_label": "Front",
      "back_label": "Back",
      "ground_front": "Ground F",
      "ground_back": "Ground B",
      "fill_label": "Fill"
    },
    "fill_zone_rule": "If soil_level_back > top_elev: tan hatch fill on Back side from top_elev to soil_level_back. Same for Front.",
    "natural_ground_rule": "Golden-brown horizontal line at soil_level_front (left of pile) and soil_level_back (right of pile)."
  },
  "soil_layers": {
    "reference_image": "giao dien/02-UI-Soil Layers.png",
    "note": "Two independent tables: Layers in Front and Layers behind. Layer top derived automatically from previous layer tip.",
    "front_layers": {
      "session_key": "front_layers_df",
      "layer1_top_source": "top_elev (Pile Top Level)",
      "used_in": "openpile p-y calculation"
    },
    "back_layers": {
      "session_key": "back_layers_df",
      "layer1_top_source": "soil_level_back (natural ground behind)",
      "used_in": "diagram display only — future integration"
    },
    "columns": [
      {"col": "Layer Tip [m]",            "type": "number", "format": "%.3f", "step": 0.5,  "geo5_equiv": "Layer Tip [m]"},
      {"col": "Density Moist [kN/m3]",    "type": "number", "format": "%.3f", "step": 0.1,  "min": 10.0, "max": 25.0, "geo5_equiv": "Density Moist [kN/m3]"},
      {"col": "Density Sub [kN/m3]",      "type": "number", "format": "%.3f", "step": 0.1,  "auto": "Density Moist - 10.0", "geo5_equiv": "Density Submerged [kN/m3]"},
      {"col": "Phi [Deg]",                "type": "number", "format": "%.3f", "step": 1.0,  "min": 0.0, "max": 45.0, "geo5_equiv": "Phi [Deg]"},
      {"col": "Delta [Deg]",              "type": "number", "format": "%.3f", "step": 1.0,  "default": 0.0, "note": "interface friction — future use", "geo5_equiv": "Delta [Deg]"},
      {"col": "Cohesion [kN/m2]",         "type": "number", "format": "%.3f", "step": 1.0,  "default": 0.0, "geo5_equiv": "Cohesion [kN/m2]"}
    ],
    "checkboxes": [
      {"label": "Automatic Density Submerged = Density Moist - 10.0", "key": "auto_sub", "geo5_equiv": "Automatic Kph Values checkbox"}
    ]
  },
  "concentrated_forces": {
    "reference_image": "giao dien/03-UI-Concentrated Forces.png",
    "columns": [
      {"col": "Horiz. Component [kN/m]", "type": "number", "format": "%.3f", "step": 1.0,  "geo5_equiv": "Horiz. Component [kN/m]"},
      {"col": "Vert. Component [kN/m]",  "type": "number", "format": "%.3f", "step": 1.0,  "geo5_equiv": "Vert. Component [kN/m]"},
      {"col": "Depth [m]",              "type": "number", "format": "%.3f", "step": 0.5,  "help": "Depth below Pile Top Level (positive downward)", "geo5_equiv": "Depth Horiz. Comp. [m]"}
    ],
    "note": "Depth=0 applies load at pile head. openpile supports head loads only in current version."
  },
  "boussinesq": {
    "reference_image": "giao dien/04-UI-Bossinesp.png",
    "columns": [
      {"col": "Distance Wall [m]",   "type": "number", "format": "%.3f", "step": 0.5, "geo5_equiv": "Distance Wall [m]"},
      {"col": "Width Surcharge [m]", "type": "number", "format": "%.3f", "step": 0.5, "geo5_equiv": "Width Surcharge [m]"},
      {"col": "Depth Surcharge [m]", "type": "number", "format": "%.3f", "step": 0.5, "geo5_equiv": "Depth Surcharge [m]"},
      {"col": "Surcharge [kN/m2]",   "type": "number", "format": "%.3f", "step": 1.0, "geo5_equiv": "Surcharge [kN/m2]"}
    ],
    "note": "Not yet integrated into openpile p-y calculation. Diagram preview only."
  },
