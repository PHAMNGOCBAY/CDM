  "formulas": {
    "_ref": "TCVN 9403:2012 Phu luc C",
    "S1": "S1 = q * H / (a * Ec + (1-a) * Es)",
    "Ec": "Ec = k * Cc_col  |  k = 50-100 (TCVN 9403 B.5.1)  |  du an dung k=100",
    "Cc_col": "Cc_col = qu_design / 2  |  qu_design = 800 kPa",
    "Es": "Es = 250 * Cu_VST  (Mesri & Olson 1974)",
    "a_square": "a = pi * D^2 / 4 / s^2  (bo tri vuong)",
    "a_triangle": "a = pi * D^2 / 4 / (sqrt(3)/2 * s^2)  (bo tri tam giac)",
    "S_reduction": "S_red = S1_CDM / S_no_treat_consolidation"
  },

  "L_cdm_formula": {
    "_note": "Chieu dai coc CDM thiet ke theo nguyen tac",
    "formula": "L = top_elev_m - elevation_m + H_soft_m + penetration_m",
    "top_elev_m": 0.8,
    "penetration_m": 1.0
  }
